; OLS300 WinUSB Driver - for Moates Roadrunner reprogrammed as OLS300
; VID=0x0547 PID=0x3000

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGUID   = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider    = %ManufacturerName%
DriverVer   = 05/30/2026,1.0.0.0
CatalogFile = ols300.cat

[Manufacturer]
%ManufacturerName% = Standard,NTx86,NTamd64

[Standard.NTx86]
%DeviceName% = USB_Install, USB\VID_0547&PID_3000

[Standard.NTamd64]
%DeviceName% = USB_Install, USB\VID_0547&PID_3000

[USB_Install]
Include    = winusb.inf
Needs      = WINUSB.NT

[USB_Install.Services]
Include    = winusb.inf
AddService = WinUSB,0x00000002,WinUSB_ServiceInstall

[WinUSB_ServiceInstall]
DisplayName    = %WinUSB_SvcDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\WinUSB.sys

[USB_Install.Wdf]
KmdfService = WINUSB, WinUSB_Install

[WinUSB_Install]
KmdfLibraryVersion = 1.11

[USB_Install.HW]
AddReg = Dev_AddReg

[Dev_AddReg]
; Device interface GUID — used by wdapi to identify the device
HKR,,DeviceInterfaceGUIDs,0x10000,"{A5DCBF10-6530-11D2-901F-00C04FB951ED}"
HKR,,DeviceInterfaceGUID,,"{A5DCBF10-6530-11D2-901F-00C04FB951ED}"

[Strings]
ManufacturerName = "EVC"
DeviceName       = "OLS300 Simulator (Roadrunner Bridge)"
WinUSB_SvcDesc   = "WinUSB"
