Class=Jungo
ClassGuid={c671678c-82c1-43f3-d700-0049433e9a4b}

[Manufacturer]
%Mfg%=DeviceList,NTx86,NTamd64,NTARM64

[DeviceList.NTx86]
"OLS300 Roadrunner Bridge"=Install, USB\VID_0547&PID_3000

[DeviceList.NTamd64]
"OLS300 Roadrunner Bridge"=Install, USB\VID_0547&PID_3000

[DeviceList.NTARM64]
"OLS300 Roadrunner Bridge"=Install, USB\VID_0547&PID_3000

[Install.NT]
